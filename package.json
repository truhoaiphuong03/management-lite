{
  "name": "management-lite",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.14.0",
    "npm": "10.9.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/check-toolchain.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev:web": "npm run --workspace=@management-lite/web dev",
    "dev:web:lan": "npm run --workspace=@management-lite/web dev:lan",
    "build:web": "npm run --workspace=@management-lite/web build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "dev:api": "npm run build && node dist/apps/api/src/main.js",
    "migrate": "npm run build && node scripts/migrate.mjs",
    "bootstrap:owner": "npm run build && node scripts/bootstrap-owner.mjs",
    "admin:create": "npm run build && node scripts/add-admin.mjs",
    "test:web": "node --test tests/web/*.test.mjs",
    "audit:ui": "node scripts/ui-audit/run.mjs",
    "test:backend": "node --test tests/backend/*.test.mjs",
    "test:db": "node --test tests/database/*.test.mjs",
    "test:security": "node --test tests/security/*.test.mjs",
    "test": "npm run build && node --test tests/foundation/*.test.mjs && node --test tests/security/*.test.mjs && node --test tests/database/*.test.mjs && node --test tests/backend/*.test.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "canonical:verify": "node scripts/verify-canonical.mjs"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
