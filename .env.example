# ==============================================================================
# Management Lite — Environment Variables Template (.env.example)
# Copy to local .env (NEVER commit real secrets to Git)
# ==============================================================================

# --- Core API & Server ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3002

# PostgreSQL connection string (NEVER point DEV/TEST to Production :55432)
DATABASE_URL=postgresql://user:password@127.0.0.1:55433/management_lite

# Required in production: >= 32 random chars (generate with: openssl rand -hex 32)
CSRF_SECRET=replace-with-at-least-32-character-random-secret

# Comma-separated list of allowed browser Origins (add https://hoaiphuong.click for public customer login)
ALLOWED_ORIGINS=https://ql.hoaiphuong.click,https://hoaiphuong.click

# Comma-separated trusted reverse proxy IPs (e.g. 127.0.0.1,::1)
TRUSTED_PROXIES=127.0.0.1,::1

# Optional session cookie override for staff auth (never shared with customer cookie)
# SESSION_COOKIE_NAME=mglite_session

# --- Public Web Customer Login (GCN-CUST-02A) ---
# OAuth 2.0 Web Client ID ("GCN Customer Login" in GCP Project 980505397989; no client secret needed)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Target Workspace UUID owning web_customers rows (MANDATORY in production; missing => /api/v1/public/* returns 503)
PUBLIC_CUSTOMER_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Shared secret between hoaiphuong.click proxy and API to trust X-GCN-Client-IP (generate with: openssl rand -hex 32)
GCN_PROXY_SECRET=replace-with-32-byte-random-hex-secret

# Current privacy policy version recorded on new customer consent
PRIVACY_POLICY_VERSION=2026-04-01

# Canonical public website origin
PUBLIC_SITE_ORIGIN=https://hoaiphuong.click
